<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows10.0.22621.0;net10.0-windows10.0.22621.0</TargetFrameworks>
    <Title>Serilog adapter for Command Palette extension hosts</Title>
    <Description>Bidirectional adapters between Command Palette extension host diagnostics and Serilog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JPSoftworks.CommandPalette.Extensions.Toolkit.Logging.Abstractions\JPSoftworks.CommandPalette.Extensions.Toolkit.Logging.Abstractions.csproj" />
    <ProjectReference Include="..\JPSoftworks.CommandPalette.Extensions.Toolkit\JPSoftworks.CommandPalette.Extensions.Toolkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JPSoftworks.CommandPalette.Extensions.Toolkit.Logging.Adapters.Test" />
  </ItemGroup>

  <Import Project="..\..\eng\Package.props" />

</Project>
